graph LR
    %% =========================================================================
    %% POSADA EC - ARQUITECTURA FUTURA (RETOS 2 Y 3) - SOLO VERTICAL ALOJAMIENTOS
    %% Verde = ya existe en el esquema booking actual. Sin color = implementación futura.
    %% =========================================================================
    classDef existente fill:#e8f5e9,stroke:#2e7d32,color:#1b5e20

    subgraph LEYENDA ["LEYENDA"]
        LG_EXI["Verde: ya existe en el esquema booking actual"]:::existente
        LG_FUT["Sin color: implementación futura (Retos 2 y 3)"]
    end

    %% =========================================================================
    %% CAPA 1: PERSISTENCIA SUPABASE / POSTGRESQL
    %% =========================================================================
    subgraph CAPA1 ["CAPA 1: PERSISTENCIA SUPABASE / POSTGRESQL (ESQUEMA booking + ESQUEMAS NUEVOS)"]
        subgraph SCH_BOOKING ["schema booking (existente)"]
            subgraph GRP_IDE ["Identidad"]
                T_USR[("usuario")]:::existente
                T_TOK[("token_usuario")]:::existente
            end

            subgraph GRP_MAE ["Maestros y reglas"]
                T_CIU[("ciudad")]:::existente
                T_TIP[("tipo_alojamiento")]:::existente
                T_AME[("amenidad")]:::existente
                T_POL[("politica_cancelacion")]:::existente
                T_POR[("politica_cancelacion_regla")]:::existente
                T_IMP[("impuesto_tarifa")]:::existente
            end

            subgraph GRP_ALO ["Alojamientos"]
                T_ALO[("alojamiento")]:::existente
                T_UNI[("unidad_alojamiento")]:::existente
                T_CAL[("calendario_unidad")]:::existente
                T_AAM[("alojamiento_amenidad")]:::existente
                T_IMG[("imagen_alojamiento")]:::existente
            end

            subgraph GRP_RES ["Reservas"]
                T_RES[("reserva")]:::existente
            end
        end

        subgraph SCH_PAG ["schema_pagos (futuro)"]
            T_PAG[("transacciones_pago")]
        end

        subgraph SCH_FAC ["schema_facturacion (futuro)"]
            T_FEN[("facturas_encabezado")]
            T_FDE[("facturas_detalle")]
        end

        subgraph SCH_AUD ["schema_auditoria (futuro)"]
            T_AUD_TRX[("auditoria_transacciones")]
            T_AUD_ADM[("auditoria_administrativa")]
            T_AUD_SAG[("auditoria_sagas")]
        end
    end

    %% =========================================================================
    %% CAPA 2: MICROSERVICIOS BÁSICOS (REST + 1 gRPC)
    %% =========================================================================
    subgraph CAPA2 ["CAPA 2: MICROSERVICIOS BÁSICOS (6 REST + 1 gRPC)"]
        MS_USR["MS Usuarios y Auth (REST / JWT)"]
        MS_ALO["MS Alojamientos (REST / Catálogo, Unidades y Calendario / Check-in 14:00)"]
        MS_RES["MS Reservas (REST / modo_reserva y Expiración)"]
        MS_FAC["MS Facturación (REST / Idempotency-Key)"]
        MS_PAG["MS Simulación Pagos SOA (REST / Idempotency-Key)"]
        MS_AUD["MS Auditoría de Negocio y Transacciones (REST)"]
        MS_STK["MS Publicador de Stock (gRPC Client Streaming hacia el integrador)"]
    end

    %% Enlaces Capa 1 a Capa 2
    T_USR -.-> MS_USR
    T_TOK -.-> MS_USR

    T_CIU -.-> MS_ALO
    T_TIP -.-> MS_ALO
    T_AME -.-> MS_ALO
    T_POL -.-> MS_ALO
    T_POR -.-> MS_ALO
    T_IMP -.-> MS_ALO
    T_ALO -.-> MS_ALO
    T_UNI -.-> MS_ALO
    T_CAL -.-> MS_ALO
    T_AAM -.-> MS_ALO
    T_IMG -.-> MS_ALO

    T_RES -.-> MS_RES
    T_PAG -.-> MS_PAG
    T_FEN -.-> MS_FAC
    T_FDE -.-> MS_FAC

    T_AUD_TRX -.-> MS_AUD
    T_AUD_ADM -.-> MS_AUD
    T_AUD_SAG -.-> MS_AUD

    T_CAL -.->|Cambios de disponibilidad| MS_STK

    %% =========================================================================
    %% CAPA 3: ESB CENTRALIZADO DE DOS CAPAS
    %% =========================================================================
    subgraph CAPA3 ["CAPA 3: ESB CENTRALIZADO DE DOS CAPAS"]
        subgraph ESB_INT ["ESB Capa Interna: Servicios Propios"]
            ESB_ROUTER["Enrutador de Negocio y Sustituto de SQL Joins entre esquemas"]
            ESB_SAGA["Orquestador Saga Reserva y Compensación"]
            ESB_POLICIES["Validación de Reglas de Negocio (políticas de cancelación, noches mín/máx, capacidad)"]
        end

        subgraph ESB_EXT ["ESB Capa de Integración: Canal con el Integrador"]
            ESB_ACL["Capa Anti-Corrupción (ACL) y Normalización DTO al contrato alojamientos-openapi.yaml"]
            ESB_CB["Circuit Breakers (Opossum) y Fallbacks"]
            ESB_KILL["Kill-Switch de Aislamiento del Canal"]
        end
    end

    %% Enlaces Capa 2 a Capa 3
    MS_USR <--> ESB_ROUTER
    MS_ALO <--> ESB_ROUTER
    MS_RES <--> ESB_ROUTER
    MS_FAC <--> ESB_ROUTER
    MS_PAG <--> ESB_ROUTER
    MS_AUD <--> ESB_ROUTER
    MS_STK -->|Stream Stock a Publicar| ESB_ACL

    ESB_ROUTER <--> ESB_SAGA
    ESB_ROUTER --> ESB_POLICIES
    ESB_ROUTER <--> ESB_ACL
    ESB_ACL --- ESB_CB
    ESB_CB --- ESB_KILL

    %% =========================================================================
    %% INTEGRADOR EXTERNO (MARKETPLACE DEL ECOSISTEMA)
    %% =========================================================================
    subgraph INTEG ["INTEGRADOR EXTERNO (MARKETPLACE BOOKING PROTOTIPO)"]
        EXT_REST["Consumo de la API REST de Alojamientos (búsqueda, compra y cancelación)"]
        EXT_GRPC["Recepción de Stock (gRPC Client Streaming)"]
    end

    EXT_REST <-->|Inbound REST Compra / Cancelación| ESB_ACL
    ESB_ACL -->|Outbound gRPC Stock| EXT_GRPC

    %% =========================================================================
    %% CAPA 4: EVENT BUS Y STREAMING (RABBITMQ + APACHE KAFKA)
    %% =========================================================================
    subgraph CAPA4 ["CAPA 4: EVENT BUS Y STREAMING DUAL (RABBITMQ + APACHE KAFKA)"]
        subgraph BROKER_RABBIT ["Broker Transaccional: RabbitMQ (AMQP 0-9-1)"]
            RB_EX["Exchange: booking.events (Topic)"]
            Q_BUY["Cola: q.reservas.confirmadas (Reservas y Contratos)"]
            Q_SAGA["Cola: q.sagas.compensacion (Rollbacks LIFO)"]
            Q_STOCK["Cola: q.stock.actualizado (Alta Prioridad)"]
            Q_DLQ["Cola: q.dead_letter (DLQ tras 3 reintentos)"]
        end

        subgraph BROKER_KAFKA ["Event Streaming Commit Log: Apache Kafka"]
            KF_BRIDGE["Cross-Broker Bridge: Conector RabbitMQ-Kafka"]
            TOPIC_CAT["Tópico: booking.alojamientos.stream (Particionado por Ciudad)"]
            TOPIC_AUD["Tópico: booking.reservas.audit (Particionado por Huésped)"]
            TOPIC_TEL["Tópico: booking.telemetria.canal (Stream de Salud y Latencia)"]
        end
    end

    ESB_ROUTER -->|Publica eventos de negocio| RB_EX
    ESB_SAGA -->|Emite reserva confirmada o fallo| RB_EX
    MS_STK -->|Emite stock.actualizado| RB_EX

    RB_EX --> Q_BUY
    RB_EX --> Q_SAGA
    RB_EX --> Q_STOCK
    RB_EX --> Q_DLQ

    RB_EX -.->|Event Sourcing Replay| KF_BRIDGE
    KF_BRIDGE --> TOPIC_CAT
    KF_BRIDGE --> TOPIC_AUD
    KF_BRIDGE --> TOPIC_TEL

    %% =========================================================================
    %% CAPA 5: MICROSERVICIOS ORQUESTADOS (LÓGICA COMPUESTA Y SEGURIDAD)
    %% =========================================================================
    subgraph CAPA5 ["CAPA 5: MICROSERVICIOS ORQUESTADOS"]
        ORQ_FAC["ORQ_FAC: Facturación Compuesta (Factura + Usuario + Detalle + Impuestos vigentes)"]
        ORQ_STK["ORQ_STK: Orquestador Stock (Consolidación de Calendario por Unidad y Catálogo)"]
        ORQ_RES["ORQ_RES: Orquestador Reservas (Checkout y Saga: Disponibilidad, Pago y Factura)"]
        SEC_AUTH["Seguridad Transversal: JWT Guard + RBAC (roles del enum rol_usuario)"]
    end

    ESB_ROUTER --> ORQ_FAC
    ESB_SAGA <--> ORQ_RES
    Q_STOCK --> ORQ_STK
    Q_BUY --> ORQ_FAC
    Q_SAGA --> ORQ_RES

    TOPIC_AUD -.->|Stream Audit Inmutable| MS_AUD
    TOPIC_TEL -.->|Stream Telemetría| ESB_CB

    ORQ_FAC --- SEC_AUTH
    ORQ_STK --- SEC_AUTH
    ORQ_RES --- SEC_AUTH

    %% =========================================================================
    %% CAPA 6: API GATEWAY Y BFF UNIFICADO (GRAPHQL / REVERSE PROXY)
    %% =========================================================================
    subgraph CAPA6 ["CAPA 6: API GATEWAY Y BFF UNIFICADO (GRAPHQL / REVERSE PROXY)"]
        GW_SEC["Gateway Security: JWT Guards + Rate Limiter + Depth Limiting"]
        GQL_SRV["Apollo Server NestJS: Single Entry Point /graphql y /api/v1/*"]
        GQL_LOAD["DataLoaders: Resolución Batch (Anti-N+1 Problem)"]
        GQL_WS["Suscripciones WebSocket (ws://) para Alertas en Vivo"]
        subgraph GQL_OPS ["Operaciones GraphQL Schema"]
            GQL_Q["Queries: alojamientosPublicados, disponibilidadUnidad, misReservas, facturaCompleta, saludCanal, auditoriaTransacciones, auditoriaSagas"]
            GQL_M["Mutations: checkoutOrquestado, cancelarReservaSaga, checkInDigital"]
            GQL_S["Subscriptions: disponibilidadActualizada, estadoReservaCambiado"]
        end
    end

    ORQ_FAC --> GQL_SRV
    ORQ_STK --> GQL_SRV
    ORQ_RES --> GQL_SRV
    MS_AUD --> GQL_SRV
    GW_SEC --- GQL_SRV
    GQL_SRV --- GQL_LOAD
    GQL_SRV --- GQL_WS
    GQL_SRV --> GQL_OPS

    %% =========================================================================
    %% CAPA 7: PRESENTACIÓN (ANGULAR 19 + CLIENTE MÓVIL + 8 PANELES ADMIN)
    %% =========================================================================
    subgraph CAPA7 ["CAPA 7: PRESENTACIÓN (POSADA EC ANGULAR 19 + CLIENTE MÓVIL)"]
        subgraph UI_CLIENT ["Cliente Web Posada EC y App Móvil"]
            UI_CAT["Catálogo de Alojamientos y Búsqueda (ciudad, tipo, fechas, huéspedes)"]
            UI_CART["Checkout de Reserva y Pago"]
            UI_BOOK["Mis Reservas y Check-in Digital"]
            UI_MOB["App Móvil: Flutter / React Native (Preparación Reto 3)"]
        end

        subgraph UI_ADMIN ["8 Paneles Administrativos Especializados"]
            ADM_NOD["1. Monitor del Canal y Kill-Switch (Semáforo verde/rojo)"]
            ADM_ALO["2. Catálogo de Alojamientos (Crear, Publicar y Maestros)"]
            ADM_CAL["3. Unidades y Calendario (Precio y Cantidad a la Venta por Fecha)"]
            ADM_RES["4. Gestión de Reservas (Estados y Expiración)"]
            ADM_FAC["5. Consola Fiscal Facturación (Impuestos vigentes y Auditoría)"]
            ADM_PAG["6. Simulador Transaccional Pagos (Inyección de Fallos SOA)"]
            ADM_STK["7. Monitor Publicación Stock gRPC (Throughput msg/seg y Sync)"]
            ADM_AUD["8. Consola Auditoría Transaccional y Sagas (Quién reservó / Quién administró)"]
        end
    end

    GQL_SRV ==>|Single Endpoint HTTP POST /graphql| UI_CLIENT
    GQL_WS ==>|Suscripciones WebSockets ws://| UI_CLIENT
    GQL_SRV -.->|Consultas y Mutaciones Administrativas| UI_ADMIN
    UI_ADMIN -.->|Comandos Directos de Kill-Switch| ESB_KILL

    %% =========================================================================
    %% LOGS TÉCNICOS FÍSICOS (WINSTON - CERO LOGS DE RED EN BD)
    %% =========================================================================
    subgraph LOGS ["TELEMETRÍA Y LOGS TÉCNICOS FÍSICOS (WINSTON - CERO LOGS RED EN BD)"]
        LOG_COMB[("logs/combined.log: Trazas Generales de Red")]
        LOG_ERR[("logs/error.log: Excepciones y Circuit Breakers")]
        LOG_AUD[("logs/audit.log: Trazabilidad Técnica y Handshakes")]
    end

    CAPA2 -.->|Winston Physical Logger| LOGS
    CAPA3 -.->|Winston Physical Logger| LOGS
    CAPA5 -.->|Winston Physical Logger| LOGS
    CAPA6 -.->|Winston Physical Logger| LOGS
