# Base de Datos (PostgreSQL / Supabase Transaction Pooler puerto 6543)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?sslmode=require"

# Servidor y Entorno
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PREFIX=api/v1

# Seguridad y Autenticación JWT (mínimo 32 caracteres)
JWT_SECRET=cambiar_por_un_secreto_aleatorio_de_minimo_32_caracteres_hex
JWT_EXPIRES_IN=7d
JWT_ISSUER=https://auth.booking-hub.com
JWT_AUDIENCE=https://api.booking-hub.com

# CORS y Frontend
FRONTEND_URL=http://localhost:5173
CORS_EXTRA_ORIGINS=http://100.x.x.x:5173,http://localhost:4173
PUBLIC_ASSETS_URL=http://localhost:5173

# Reglas de Negocio / Impuestos
IVA_RATE=0.15
TASA_MUNICIPAL=2.00

# Integración gRPC hacia Booking Prototipo
GRPC_ENABLED=true
GRPC_PORT=50051
BOOKING_GRPC_URL=127.0.0.1:50051
GRPC_SERVICE_ID=alojamientos

# Semilla de Usuarios (para script de generación de contraseñas)
SEED_ADMIN_PASSWORD=AdminPass123!*
